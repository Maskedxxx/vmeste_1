# === Docker Compose ===
COMPOSE_PROJECT_NAME=vmeste

# === Environment ===
APP_ENV=production

# === API Server (ЗАПОЛНИТЬ!) ===
API_HOST=0.0.0.0
API_PORT=8000

# === PostgreSQL (ЗАПОЛНИТЬ!) ===
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=vmeste
POSTGRES_USER=
POSTGRES_PASSWORD=

# === Chroma (ЗАПОЛНИТЬ!) ===
CHROMA_HOST=vmeste-chroma
CHROMA_PORT=8001

# === LLM (ЗАПОЛНИТЬ!) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# === Telegram Bot (ЗАПОЛНИТЬ!) ===
TELEGRAM_BOT_TOKEN=
VMESTE_API_BASE=http://vmeste-api:8000

# === Observability (опционально) ===
LANGFUSE_HOST=
LANGFUSE_API_KEY=

# === Development only (не для production) ===
# POSTGRES_EXTERNAL_PORT=5433