# Compose
COMPOSE_PROJECT_NAME=vmeste

# Environment (development | production | test)
APP_ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
# Development: используйте vmeste-postgres (контейнер из docker-compose.yml)
# Production: укажите адрес внешнего сервера БД
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vmeste
POSTGRES_USER=vmeste
POSTGRES_PASSWORD=vmeste_password

# Vector store (Chroma)
CHROMA_HOST=vmeste-chroma
CHROMA_PORT=8001

# LLM providers (обязательно для работы агентов)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
YANDEXGPT_API_KEY=

# Telegram bot (опционально)
TELEGRAM_BOT_TOKEN=
VMESTE_API_BASE=http://vmeste-api:8000

# Observability (опционально)
LANGFUSE_HOST=
LANGFUSE_API_KEY=
