# ============================================================
#                    VMESTE CONFIGURATION
# ============================================================

# === Docker Compose ===
COMPOSE_PROJECT_NAME=vmeste

# === Environment ===
APP_ENV=development

# ============================================================
#                         ПОРТЫ
# ============================================================
# Внешние порты (на вашей машине, localhost)
# Измените если порты уже заняты

API_EXTERNAL_PORT=8000           # localhost:8000 -> API
CHROMA_EXTERNAL_PORT=8001        # localhost:8001 -> ChromaDB
POSTGRES_EXTERNAL_PORT=5433      # localhost:5433 -> PostgreSQL

# ============================================================
#                     ПОДКЛЮЧЕНИЯ
# ============================================================
# Настройки для связи между сервисами внутри Docker

# --- API ---
API_HOST=0.0.0.0

# --- PostgreSQL ---
POSTGRES_HOST=vmeste-postgres    # имя контейнера в Docker сети
POSTGRES_PORT=5432               # внутренний порт PostgreSQL
POSTGRES_DB=vmeste
POSTGRES_USER=vmeste
POSTGRES_PASSWORD=vmeste_password

# --- ChromaDB ---
CHROMA_HOST=vmeste-chroma        # имя контейнера в Docker сети
CHROMA_PORT=8000                 # внутренний порт ChromaDB

# ============================================================
#                    API КЛЮЧИ (ЗАПОЛНИТЬ!)
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=

# ============================================================
#                 ВНУТРЕННИЕ СВЯЗИ (не менять)
# ============================================================

VMESTE_API_BASE=http://vmeste-api:8000

# === Observability (опционально) ===
LANGFUSE_HOST=
LANGFUSE_API_KEY=
